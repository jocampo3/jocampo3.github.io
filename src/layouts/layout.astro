---
import Header from "./header.astro";
import Footer from "./footer.astro";
import '../styles/css/styles.css';


interface Props {
  title?: string;
  metaKeywords?: string[];
  metaDescription?: string;
}

const {
  title = "Jose Ocampo",
  metaKeywords = [
    "jose ocampo",
    "portfolio",
    "work experience",
    "computer science",
    "software development",
    "personal site",
  ],
  metaDescription = "Software Developer and Computer Science Graduate specializing in Ruby on Rails, Python backend services, and Web Developement.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/triforce.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Jose Ocampo">
    <meta name="keywords" content=`${metaKeywords}` />
    <meta name="description" content={metaDescription} />
    <title>{title}</title>
	</head>
  <body class="">
    <Header/>
      <slot />
    <Footer/>
	</body>
</html>

<style>
	html,
	body {
    font-family: monospace;
    scroll-behavior: smooth;
  }
</style>
