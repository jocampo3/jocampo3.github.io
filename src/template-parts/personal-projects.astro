---
import ProjectCard from "../components/project-card.astro";
---

<section id="personal-projects" class="projects flex flex-col justify-center items-center py-16">
  <h1 class="text-center text-4xl md:text-5xl lg:text-5xl pb-2">Personal Projects</h1>
  <p class="text-xl text-center italic text-[#CFCDDF] pb-6 mx-5">Hobby projects I may or may have not procrastinated... (jk)</p>
  <div class="projects-container grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-3 max-w-[1200px] ml-12 gap-20" id="projects">
    <ProjectCard projectLink="https://www.npmjs.com/package/@jocampo3/slider" projectImage="assets/images/slider-npm-screenshot.png" projectType="NPM Package" projectName="Slider NPM Package" projectFramework="JavaScript" projectDesc="Tired of bulky external NPM packages, I built this lightweight, easy-to-import package. It delivers essential carousel functionality with minimal JavaScript, keeping my projects fast and clean."/>
    <ProjectCard projectLink="https://www.medium.com/p/6e915c64364f" projectImage="assets/images/medium-article.png" projectType="Article" projectName="Ruby on Rails 101: CRUD" projectFramework="Ruby on Rails" projectDesc="I wrote an article for Rails beginners on setting up their Rails app and adding basic CRUD operations to their site"/>
    <ProjectCard projectLink="/" projectImage="assets/images/fridge-app-screenshot.png" projectType="Desktop App" projectName="Fridge Inventory Management App" projectFramework="Python + Astro" projectDesc="A WIP project built for my raspberry PI that enables my wife and I to visually see what comes in and out of our fridge. Routes are built with FastAPI, and I have also implmented OpenAI's API to view the products in my database and provide receipe ideas for when I am feeling too lazy to come up with something on my own. I have plans to make this an open-source project in the future."/>
    <ProjectCard projectLink="/" projectImage="assets/images/slippi-mobile-screenshot.png" projectType="Mobile App" projectName="Slippi Mobile" projectFramework="React Native" projectDesc="Designing a application to view Slippi vods that use Slippi data to provide feedback to the user on their play, on the go"/>
    <ProjectCard projectLink="https://www.youtube.com/watch?v=tWfcJgZFfcs" projectImage="assets/images/waterfall-raindrops.png" projectType="Song" projectName="Waterfall Raindrops" projectFramework="Ableton Live" projectDesc="A song I produced and wrote during my DAW obsession phase. I hope to one day come back to music as a whole and continue to develop that aspect of my life."/>
	</div>
</section>
