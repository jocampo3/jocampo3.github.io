---
import ProjectCard from "../components/project-card.astro";
---

<section id="projects" class="projects flex flex-col justify-center items-center py-16">
  <h1 class="text-center text-4xl md:text-5xl lg:text-5xl pb-2">Professional Projects</h1>
  <p class="text-xl text-center italic text-[#CFCDDF] pb-6 mx-5">Projects I have worked on from branding websites to full-stack CMS</p>
  <div class="projects-container grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-3 max-w-[1200px] ml-12 gap-20" id="projects">
    <ProjectCard projectLink="" projectImage="assets/images/tiffin-motorhomes-screenshot.webp" projectType="Website" projectName="Tiffin Motorhomes - CMS Redesign" projectFramework="Wordpress + ACF" projectDesc="A fully custom CMS website built for Tiffin Motorhomes. I completely replaced the old UI as well as the ACF structure, introducing quality-of-life improvements for building out coach models and navigations."/>
    <ProjectCard projectLink="https://cornerstoneluxury.com" projectImage="assets/images/cornerstone-screenshot.webp" projectType="Website" projectName="Cornerstone Luxury" projectFramework="Wordpress + ACF" projectDesc="A responsive CMS website built for Tiffin Cornerstone Luxury RV. This is my most modular WP project so far, containing the most amount of CMS capability out of all of my professional projects thus far."/>
    <ProjectCard projectLink="https://theelementalyou.com/" projectImage="assets/images/elemental-screenshot.png" projectType="Website" projectName="Elemental" projectFramework="Astro" projectDesc="A responsive branding website I designed using Astros component-based architecture, allowing for quick updates based on client and designer feedback"/>
    <ProjectCard projectLink="https://tiffinadventure.com" projectImage="assets/images/ta-screenshot.png" projectType="Website" projectName="Tiffin Adventure" projectFramework="Wordpress + ACF" projectDesc="Custom CMS site for Tiffin Motorhomes. Collaborated with Mindvolt to successfully design website into a fully customizable platform"/>
    <ProjectCard projectLink="https://pklfreeze.com" projectImage="assets/images/pklfreeze-screenshot.png" projectType="Website" projectName="PKLfreeze" projectFramework="Wordpress" projectDesc="A product branding site I designed using Divy and Wordpress to promote sales of PKLfreeze pops"/>
    <ProjectCard projectLink="https://www.gundeals.me" projectImage="assets/images/gundeals-screenshot.png" projectType="Website" projectName="Gundeals" projectFramework="Django" projectDesc="A full stack Django application built for Gunprime aggregates inventory feeds from local and nationwide FFLs, normalizing product data, and helps users find the best firearm deals"/>
	</div>
</section>
