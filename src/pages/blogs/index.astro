---
import Layout from '../../layouts/layout.astro';
import BlogCard from '../../components/blog-card.astro';
---

<Layout>
  <main>
    <div class="blog-page-content flex flex-col items-center justify-center py-16">
      <h1 class="!text-7xl pb-6">Blogs</h1>
      <p class="text-xl text-center italic text-[#CFCDDF] pb-10 mx-5">
        Welcome to my blogs! Here, you will find some yaps about things I am passionate about—from all things CS to more personal topics such as music and faith.
      </p>
      <div class="w-[85%] flex flex-col items-center justify-center sm:grid sm:grid-cols-2 md:grid lg:grid md:grid-cols-2 lg:grid-cols-3 mx-auto">
        <BlogCard
          blogName='Insertion Sort'
          blogLink='/blogs/algorithms/insertion-sort'
          blogImage='/assets/images/insertion-sort.webp'
          blogDesc='Insertion Sort is an efficient algorithm for sorting a small number of elements. The most common illustration used for demonstrating insertion sort is playing cards. We start with an empty left hand...'
        />
      </div>
    </div>
  </main>
</Layout>
