---
interface Props {
  blogName: string;
  blogLink?: string;
  blogTarget?: string;
  blogDesc?: string;
  blogImage?: string;
  blogCategories?: string[];
}
const { blogName, blogDesc, blogLink, blogTarget, blogImage } = Astro.props;
---
<a href={blogLink} target={blogTarget} class="blog border-2 border-solid border-gray-100 rounded-xl max-w-[90%]">
  <div class="blog-content flex flex-col">
    <img src={blogImage} alt=`${blogName.replaceAll(" ", "-")}-image` class="mb-2 rounded-lg h-[175px]"/>
    <h4 class="blog-name text-white font-bold text-2xl pt-1 px-4">{blogName}</h4>
    <p class="blog-desc text-[#e4e2f0] text-lg pt-1 px-4 pb-4">{blogDesc}</p>
  </div>
</a>

<style>
.blog {
  background-color: #312d5b;
  transition: transform .6s ease;
  max-height: 400px;
  min-height: 350px;
}

.blog:hover {
  transform: translateY(-1px) scale(1);
  background-color: #3d3a63;
}

@media (max-width: 768px) {
  .blog:hover {
  transform: none;
  }
}

a {
	cursor: pointer;
}
</style>
