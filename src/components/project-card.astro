---
interface Props {
  projectName: string;
  projectLink?: string;
  projectType?: string;
  projectFramework?: string;
  projectDesc?: string;
  projectImage?: string;
  projectStatus?: string;
}
const { projectName, projectDesc, projectFramework, projectLink, projectType, projectImage, projectStatus } = Astro.props;

// let statusClass = 'complete';
// statusClass = projectStatus == 'incomplete' ? 'incomplete' : 'complete';
---
<a href={projectLink} target="_blank" class="project border-2 border-solid border-gray-100 rounded-xl max-w-[90%]">
  <div class="project-content flex flex-col">
    <img src={projectImage} alt=`${projectName.replaceAll(" ", "-")}-image` class="mb-2 rounded-lg h-[175px]"/>
    <div class="flex justify-between px-4">
      <p class="project-type text-[#cdcdcd]">{projectType}</p>
      <p class="project-framework text-[#cdcdcd]">{projectFramework}</p>
    </div>
    <h4 class="project-name text-white font-bold text-2xl pt-1 px-4">{projectName}</h4>
    <p class="project-desc text-[#cdcdcd]  text-lg pt-1 px-4 pb-4">{projectDesc}</p>
  </div>
</a>

<style>
.project {
  background-color: #3C3857;
  transition: transform .6s ease;
}

.project:hover {
  transform: translateY(-8px) scale(1);
  background-color: rgba(42, 40, 62, 0.8);
}

@media (max-width: 768px) {
  .project:hover {
  transform: none;
  }
}

a {
	cursor: pointer;
}
</style>
